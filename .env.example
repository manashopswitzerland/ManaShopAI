# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=development                          # development | production | test
PORT=3000                                     # HTTP port the server listens on

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mana-ai-hub
# Production example: mongodb+srv://user:pass@cluster.mongodb.net/mana-ai-hub?retryWrites=true&w=majority

# ─────────────────────────────────────────────
# OPENAI
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...                         # OpenAI secret key
OPENAI_MODEL=gpt-4o                           # Model to use; change to gpt-4o-mini for cheaper dev runs

# ─────────────────────────────────────────────
# SHOPIFY — MANA SHOP
# ─────────────────────────────────────────────
SHOPIFY_MANA_SHOP_DOMAIN=mana-shop.myshopify.com
SHOPIFY_MANA_SHOP_TOKEN=shpat_...            # Admin API access token for mana-shop

# ─────────────────────────────────────────────
# SHOPIFY — MANA KENDRA
# ─────────────────────────────────────────────
SHOPIFY_MANA_KENDRA_DOMAIN=mana-kendra.myshopify.com
SHOPIFY_MANA_KENDRA_TOKEN=shpat_...          # Admin API access token for mana-kendra

# ─────────────────────────────────────────────
# TWILIO (WhatsApp via Twilio Sandbox / Business)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER_MANA_SHOP=+41xxxxxxxxx      # Twilio number assigned to mana-shop
TWILIO_WHATSAPP_NUMBER_MANA_KENDRA=+41xxxxxxxxx    # Twilio number assigned to mana-kendra

# ─────────────────────────────────────────────
# SENDGRID (outbound email)
# ─────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=info@mana-shop.ch               # Verified sender address in SendGrid

# ─────────────────────────────────────────────
# IMAP (inbound email monitoring)
# ─────────────────────────────────────────────
IMAP_HOST=imap.example.com                   # IMAP server hostname
IMAP_PORT=993                                # 993 for TLS (default), 143 for STARTTLS
IMAP_USER=info@mana-shop.ch                  # IMAP account username
IMAP_PASSWORD=your-email-password            # IMAP account password or app-specific password

# ─────────────────────────────────────────────
# ADMIN
# ─────────────────────────────────────────────
ADMIN_API_KEY=change-me-to-a-long-random-secret   # Protects POST /admin/sync-shopify
